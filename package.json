{
  "name": "scionwood",
  "version": "0.2.0",
  "description": "Worktrees for opencode that pull down code you didn't write — each with its own index",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/plugin.d.ts",
  "bin": {
    "wt": "dist/scripts/wt"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/index.js"
    },
    "./wt": "./dist/scripts/wt"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "build:clean": "rm -rf dist && npm run build",
    "test": "bun test ./.opencode/plugins/scionwood.test.ts && bash .opencode/scripts/wt test",
    "test:plugin": "bun test ./.opencode/plugins/scionwood.test.ts",
    "test:bash": "bash .opencode/scripts/wt test",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "worktree",
    "git-worktree",
    "pr-review",
    "code-review",
    "codegraph",
    "monorepo",
    "gitlab",
    "merge-request"
  ],
  "author": {
    "name": "Selçuk Usta",
    "email": "selcukusta@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selcukusta/scionwood.git"
  },
  "bugs": {
    "url": "https://github.com/selcukusta/scionwood/issues"
  },
  "homepage": "https://github.com/selcukusta/scionwood#readme",
  "engines": {
    "node": ">=18",
    "bun": ">=1.3"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@types/node": "*",
    "bun-types": "*",
    "typescript": "*"
  }
}
