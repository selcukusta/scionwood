#!/usr/bin/env bash
set -euo pipefail

# Effective config as JSON, resolved by load_config from four layers:
#   built-in defaults < ~/.config/wt/config.json < <repo>/.opencode/wt.json < WT_*
WT_CONFIG=""
# CFG_BASE_PATH stays a plain global: main_root_from reads it before any config
# has been loaded, so it must always hold a usable value.
CFG_BASE_PATH=".git-worktrees"
_CFG_LOADED=false

usage() {
  cat <<'EOF'
usage:
  wt new <name> [--pr N | --branch <ref> | --from <ref>] [--no-open]
                              create <basePath>/<name> and bootstrap it
                              no source flag: branch from the repo default branch
                              --pr N      fetch a pull/merge request (see prRef)
                              --branch R  track an existing remote branch
                              --from R    branch from a tag, sha or branch
                              --no-open   print the cd line instead of launching
                              with --pr and no name, the worktree is named pr-N
  wt list                     list worktrees and their branches
  wt config [--layers]        print the effective config; --layers also shows
                              which file each layer came from
  wt open <name>              open opencode in an existing worktree
  wt bootstrap [name|path]    (re)create symlinks, run hooks and tool setup
  wt clean [name|path]        remove worktree artifacts only (symlinks + tool
                              data dirs), keep the worktree and branch
  wt teardown [name|path] [--force]
                              remove worktree + branch + tool data
                              refuses if the worktree is dirty or the branch has
                              unmerged commits; --force discards them
                              name = folder under <basePath> (works from anywhere)
                              path = direct path; default: the worktree you are in
  wt install [--config-home <dir>]
                              machine setup, run once: writes the global wt
                              command and ~/.config/wt/config.json
  wt init [--force]           repository setup: writes <repo>/.opencode/wt.json
  wt test                     run the built-in smoke tests (throwaway repo)

env:
  WT_OPEN=auto|exec|tab|none  how to launch opencode after "new"/"open" (default: auto)
                              auto: same tab when run from a terminal, otherwise a new
                              tab (iTerm2) / window (Ghostty) in the current terminal app
                              exec: always same tab   tab: force new tab   none: print only
  WT_MAIN_ROOT=/path          act on this repository instead of the one containing
                              the current directory (autodetection is the default)
  WT_CONFIG_HOME=/path        override the config directory (default: ~/.config)
  WT_BIN=/path                install target directory (default: /opt/homebrew/bin,
                              /usr/local/bin or ~/.local/bin)

config overrides (env beats <repo>/.opencode/wt.json, which beats
~/.config/wt/config.json, which beats built-in defaults):
  WT_BASE=path                worktree base path (default: .git-worktrees)
  WT_BRANCH_PREFIX=prefix     branch prefix for new worktrees (default: wt/)
  WT_PR_REF=template          pull/merge-request ref (default: pull/{n}/head)
                              GitLab: merge-requests/{n}/head
  WT_FILES_TO_LINK=a,b        comma-separated files/dirs to symlink into worktrees
EOF
  exit 1
}

die() { echo "wt: error: $*" >&2; exit 1; }

main_root_from() { # $1 start dir, $2 optional basePath marker (default: CFG_BASE_PATH)
  local dir="$1" marker="${2:-}"
  if [[ -z "$marker" ]]; then
    marker="${CFG_BASE_PATH:-.git-worktrees}"
    marker="${marker#./}"
    marker="/${marker}"
  fi
  if [[ -n "${WT_MAIN_ROOT:-}" && -d "$WT_MAIN_ROOT/.git" ]]; then
    echo "$WT_MAIN_ROOT"
    return 0
  fi
  while [[ "$dir" != "/" ]]; do
    if [[ "$dir" != *"$marker"* && -d "$dir/.git" ]]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

# Runs a lifecycle hook. The configured value is either a path to an executable
# file (preferred -- the user edits a real script) or an inline shell command.
# A missing or non-executable file warns and continues: a hook is a convenience,
# never a gate on having a usable worktree.
run_hook() { # $1 phase (postCreate|preTeardown), $2 worktree
  local phase="$1" wt="$2" spec main_root name branch candidate
  spec="$(cfg ".hooks.$phase")"
  [[ -n "$spec" ]] || return 0

  main_root="$(main_root_from "$wt")" || main_root=""
  name="$(basename "$wt")"
  branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

  candidate="$spec"
  [[ "$candidate" != /* ]] && candidate="$main_root/$spec"

  if [[ -e "$candidate" ]]; then
    if [[ ! -x "$candidate" ]]; then
      echo "wt: warning: hook $phase is not executable: $candidate (chmod +x it)" >&2
      return 0
    fi
    echo "  hook  $phase ($spec)"
    if ! (cd "$wt" && WT_NAME="$name" WT_ROOT="$wt" WT_MAIN_ROOT="$main_root" WT_BRANCH="$branch" \
          "$candidate"); then
      echo "wt: warning: hook $phase failed" >&2
    fi
    return 0
  fi

  # The value does not exist on disk. A bare word that looks like a path is a
  # missing file -- warn, because silently shell-executing a typo'd path is
  # worse than doing nothing. Anything containing whitespace is a command: an
  # inline command frequently contains "/" too, so "/" alone cannot decide.
  case "$spec" in
    *[[:space:]]*) ;;
    *.sh|*/*)
      echo "wt: warning: hook $phase not found: $candidate" >&2
      return 0 ;;
  esac

  echo "  hook  $phase (inline)"
  if ! (cd "$wt" && WT_NAME="$name" WT_ROOT="$wt" WT_MAIN_ROOT="$main_root" WT_BRANCH="$branch" \
        bash -c "$spec"); then
    echo "wt: warning: hook $phase failed" >&2
  fi
  return 0
}

tool_names() { jq -r '(.tools // {}) | keys_unsorted[]' <<<"$WT_CONFIG"; }

tool_data_dir() { # $1 tool, $2 worktree; prints the absolute dataDir, or nothing
  local raw name
  raw="$(jq -r --arg t "$1" '.tools[$t].dataDir // empty' <<<"$WT_CONFIG")"
  [[ -n "$raw" ]] || return 0
  name="$(basename "$2")"
  echo "$2/${raw//\{name\}/$name}"
}

# Expand {name} {worktree} {mainRoot} {branch} {dataDir} in a template.
tool_expand() { # $1 tool, $2 template, $3 worktree
  local tool="$1" tpl="$2" wt="$3" name main_root branch data
  name="$(basename "$wt")"
  main_root="$(main_root_from "$wt")" || main_root=""
  branch="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
  data="$(tool_data_dir "$tool" "$wt")"
  tpl="${tpl//\{name\}/$name}"
  tpl="${tpl//\{worktree\}/$wt}"
  tpl="${tpl//\{mainRoot\}/$main_root}"
  tpl="${tpl//\{branch\}/$branch}"
  tpl="${tpl//\{dataDir\}/$data}"
  printf '%s' "$tpl"
}

# Paths wt created inside the worktree: the symlinks it made and each tool's
# data dir. These are artifacts of the tool, not the user's work, so the
# teardown safety check must not count them as uncommitted changes -- otherwise
# linking a file that is not gitignored makes every teardown refuse forever.
wt_own_paths() { # $1 worktree
  local f d
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    [[ -L "$1/$f" ]] && echo "$f"
  done < <(cfg_list '.filesToLink')
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    case "$d" in "$1"/*) echo "${d#$1/}" ;; esac
  done < <(tools_data_dirs "$1")
  return 0
}

tools_data_dirs() { # $1 worktree
  local t d
  while IFS= read -r t; do
    [[ -n "$t" ]] || continue
    d="$(tool_data_dir "$t" "$1")"
    [[ -n "$d" ]] && echo "$d"
  done < <(tool_names)
  return 0
}

# Runs `setup` or `teardown` for every configured tool with that tool's env
# exported. A tool whose `detect` binary is missing is skipped with a warning --
# never a hard failure, so a worktree stays usable without every tool present.
tools_run() { # $1 phase (setup|teardown), $2 worktree
  local phase="$1" wt="$2" t detect cmd data k v
  while IFS= read -r t; do
    [[ -n "$t" ]] || continue
    detect="$(jq -r --arg t "$t" '.tools[$t].detect // empty' <<<"$WT_CONFIG")"
    if [[ -n "$detect" ]] && ! command -v "$detect" >/dev/null 2>&1; then
      echo "  skip  tool '$t' ('$detect' not on PATH)"
      continue
    fi
    data="$(tool_data_dir "$t" "$wt")"
    [[ -n "$data" && "$phase" == "setup" ]] && mkdir -p "$data"

    cmd="$(jq -r --arg t "$t" --arg p "$phase" '.tools[$t][$p] // empty' <<<"$WT_CONFIG")"
    [[ -n "$cmd" ]] || continue
    cmd="$(tool_expand "$t" "$cmd" "$wt")"

    local -a envs=()
    while IFS= read -r k; do
      [[ -n "$k" ]] || continue
      v="$(jq -r --arg t "$t" --arg k "$k" '.tools[$t].env[$k] // ""' <<<"$WT_CONFIG")"
      envs+=("$k=$(tool_expand "$t" "$v" "$wt")")
    done < <(jq -r --arg t "$t" '(.tools[$t].env // {}) | keys_unsorted[]' <<<"$WT_CONFIG")

    echo "  tool  $t $phase"
    if ! (cd "$wt" && env ${envs[@]+"${envs[@]}"} bash -c "$cmd"); then
      echo "wt: warning: tool '$t' $phase failed" >&2
    fi
  done < <(tool_names)
  return 0
}

bootstrap_dir() {
  local wt="$1"
  local main_root name f d
  main_root="$(main_root_from "$wt")" || die "could not locate main repository root above $wt"
  load_config "$main_root"
  name="$(basename "$wt")"

  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    if [[ ! -e "$main_root/$f" ]]; then
      echo "  skip  $f (not in main repo)"
      continue
    fi
    if [[ -e "$wt/$f" && ! -L "$wt/$f" ]]; then
      echo "  skip  $f (real file exists in worktree)"
      continue
    fi
    mkdir -p "$(dirname "$wt/$f")"
    ln -sfn "$main_root/$f" "$wt/$f"
    echo "  link  $f -> $main_root/$f"
  done < <(cfg_list '.filesToLink')

  run_hook postCreate "$wt"

  tools_run setup "$wt"

  echo "  bootstrap complete: $wt"
}

open_in_terminal() {
  local wt="$1"
  local mode="${WT_OPEN:-auto}"

  if [[ "$mode" == "none" ]]; then
    echo "open it:  cd \"$wt\" && opencode"
    return 0
  fi

  if [[ "$mode" == "auto" && -t 0 ]] || [[ "$mode" == "exec" ]]; then
    cd "$wt" && opencode
    return 0
  fi

  local esc="$wt"
  esc="${esc//\\/\\\\}"
  esc="${esc//\"/\\\"}"

  case "${TERM_PROGRAM:-}" in
    iTerm.app)
      if osascript <<APPLESCRIPT >/dev/null 2>&1
tell application "iTerm2"
  activate
  if (count of windows) = 0 then
    create window with default profile
  else
    tell current window to create tab with default profile
  end if
  tell current session of current window to write text "cd \"$esc\" && opencode"
end tell
APPLESCRIPT
      then
        echo "opencode opened in a new iTerm2 tab"
        return 0
      fi
      ;;
    ghostty)
      if open -na ghostty --args --working-directory="$wt" -e sh -c "opencode; exec \${SHELL:-/bin/zsh}" >/dev/null 2>&1; then
        echo "opencode opened in a new Ghostty window"
        return 0
      fi
      ;;
  esac

  echo "open it:  cd \"$wt\" && opencode"
}

default_base_ref() { # $1 main_root; prints the repository's default branch ref
  local main_root="$1" ref
  ref="$(git -C "$main_root" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [[ -n "$ref" ]]; then
    echo "${ref#refs/remotes/}"
    return 0
  fi
  git -C "$main_root" rev-parse --abbrev-ref HEAD
}

cmd_new() {
  local name="" src_kind="" src_val="" no_open=false arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --pr|--branch|--from)
        [[ $# -ge 2 ]] || die "option $arg requires a value"
        [[ -z "$src_kind" ]] || die "only one source may be given, got --$src_kind and $arg"
        src_kind="${arg#--}"; src_val="$2"; shift 2 ;;
      --pr=*|--branch=*|--from=*)
        [[ -z "$src_kind" ]] || die "only one source may be given, got --$src_kind and ${arg%%=*}"
        src_kind="${arg%%=*}"; src_kind="${src_kind#--}"; src_val="${arg#*=}"; shift ;;
      --no-open) no_open=true; shift ;;
      -*) die "unknown option for new: $arg (see --help)" ;;
      *)
        [[ -z "$name" ]] || die "new takes at most one name, got '$name' and '$arg'"
        name="$arg"; shift ;;
    esac
  done

  if [[ -z "$name" ]]; then
    [[ "$src_kind" == "pr" ]] || die "a worktree name is required (or use --pr <n>)"
    name="pr-$src_val"
  fi
  [[ "$name" != */* ]] || die "worktree name must be a plain folder name, got: $name"

  local main_root
  main_root="$(main_root_from "$(pwd -P)")" \
    || die "could not locate the main repository (run from inside the repo, or set WT_MAIN_ROOT)"
  load_config "$main_root"

  local branch base_path wt
  branch="$(cfg '.branchPrefix')$name"
  base_path="$(cfg '.basePath')"
  wt="$main_root/$base_path/$name"
  [[ -e "$wt" ]] && die "worktree already exists: $wt"
  mkdir -p "$main_root/$base_path"

  # Always fetch: it is read-only and cheap. Never pull/rebase -- mutating the
  # branch the user has checked out is a side effect creating a worktree should
  # not have.
  git -C "$main_root" fetch --prune origin >/dev/null 2>&1 || true

  case "$src_kind" in
    pr)
      [[ "$src_val" =~ ^[0-9]+$ ]] || die "--pr expects a number, got: $src_val"
      local ref
      ref="$(cfg '.prRef')"
      ref="${ref//\{n\}/$src_val}"
      git -C "$main_root" fetch origin "$ref:$branch" \
        || die "could not fetch $ref from origin (does #$src_val exist? for GitLab set prRef to merge-requests/{n}/head)"
      git -C "$main_root" worktree add "$wt" "$branch"
      ;;
    branch)
      git -C "$main_root" fetch origin "$src_val" \
        || die "could not fetch branch '$src_val' from origin"
      git -C "$main_root" worktree add -b "$branch" "$wt" FETCH_HEAD
      ;;
    from)
      git -C "$main_root" rev-parse --verify --quiet "$src_val^{commit}" >/dev/null \
        || die "not a known commit, branch or tag: $src_val"
      git -C "$main_root" worktree add -b "$branch" "$wt" "$src_val"
      ;;
    *)
      local base
      base="$(default_base_ref "$main_root")"
      git -C "$main_root" worktree add -b "$branch" "$wt" "$base"
      ;;
  esac

  bootstrap_dir "$wt"
  if $no_open; then
    echo "open it:  cd \"$wt\" && opencode"
  else
    open_in_terminal "$wt"
  fi
}

cmd_bootstrap() {
  local wt mr
  mr="$(main_root_from "$(pwd -P)")" || die "could not locate the main repository"
  load_config "$mr"
  wt="$(resolve_worktree_target "${1:-}" | tail -1)"
  bootstrap_dir "$wt"
}

cmd_list() {
  local main_root base d name branch found=""
  main_root="$(main_root_from "$(pwd -P)")" || die "could not locate the main repository"
  load_config "$main_root"
  base="$main_root/$CFG_BASE_PATH"
  if [[ -d "$base" ]]; then
    for d in "$base"/*/; do
      [[ -d "$d" ]] || continue
      found=1
      name="$(basename "$d")"
      branch="$(git -C "$main_root" worktree list --porcelain 2>/dev/null | awk -v w="${d%/}" '
        /^worktree / { inblock = ($0 == "worktree " w) }
        inblock && /^branch / { sub(/^branch /, ""); print; exit }
      ')"
      branch="${branch#refs/heads/}"
      echo "  $name  (${branch:-detached})"
    done
  fi
  if [[ -z "$found" ]]; then
    echo "no review worktrees under $base"
  fi
}

cmd_open() {
  local name="${1:-}"
  [[ -n "$name" ]] || usage
  local main_root wt
  main_root="$(main_root_from "$(pwd -P)")" || die "could not locate the main repository"
  load_config "$main_root"
  wt="$main_root/$CFG_BASE_PATH/$name"
  [[ -d "$wt" ]] || die "worktree not found: $CFG_BASE_PATH/$name (see 'wt list')"
  open_in_terminal "$wt"
}

require_jq() {
  command -v jq >/dev/null 2>&1 \
    || die "'jq' is required (install with: brew install jq)"
}

# Reads one JSON document per line on stdin, prints the merged document.
# Layer order is lowest precedence first.
#
#   objects  merge by key, recursively; a "!x" KEY in a later layer removes an
#            inherited "x" key
#   arrays   union preserving first-seen order; a "!x" ENTRY in a later layer
#            removes an inherited "x" entry
#
# One rule, two shapes: a "!"-prefixed name always means "drop what I inherited".
#   null     in a later layer does not clobber an earlier value
#   false    is a value, not an absence (the classic `//` bug)
config_merge() {
  require_jq
  jq -c -s '
    def uniq: reduce .[] as $x ([]; if index([$x]) then . else . + [$x] end);

    def merge($a; $b):
      if   $b == null then $a
      elif ($a|type) == "object" and ($b|type) == "object" then
        ( reduce ($b|keys_unsorted[]) as $k ($a; .[$k] = merge($a[$k]; $b[$k])) ) as $m
        | ( $b | keys_unsorted | map(select(startswith("!"))) ) as $marks
        | ( $m | delpaths( (($marks + ($marks | map(.[1:]))) | map([.])) ) )
      elif ($a|type) == "array" and ($b|type) == "array" then
        ( ($a + ($b | map(select((type=="string" and startswith("!")) | not)))) | uniq ) as $u
        | ( $b | map(select(type=="string" and startswith("!")) | .[1:]) ) as $rm
        | ( $u | map(. as $x | select(($rm | index([$x])) == null)) )
      else $b end;

    reduce .[1:][] as $layer (.[0]; merge(.; $layer))
  '
}

config_home() {
  echo "${WT_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}}"
}

global_config_path() { echo "$(config_home)/wt/config.json"; }

config_defaults_json() {
  cat <<'JSON'
{
  "basePath": ".git-worktrees",
  "branchPrefix": "wt/",
  "prRef": "pull/{n}/head",
  "filesToLink": ["CLAUDE.local.md", ".claude/settings.local.json", ".env"],
  "hooks": {},
  "tools": {
    "codegraph": {
      "detect": "codegraph",
      "dataDir": ".codegraph-{name}",
      "env": { "CODEGRAPH_PROJECT_PATH": "{worktree}", "CODEGRAPH_DATA_DIR": "{dataDir}" },
      "setup": "codegraph init -i && codegraph sync"
    }
  }
}
JSON
}

# Build the env layer from WT_* variables. An absent variable contributes
# nothing, so it can never clobber a lower layer with null.
config_env_json() {
  local j='{}'
  [[ -n "${WT_BASE:-}" ]]          && j="$(jq -c --arg v "$WT_BASE" '.basePath=$v' <<<"$j")"
  [[ -n "${WT_BRANCH_PREFIX:-}" ]] && j="$(jq -c --arg v "$WT_BRANCH_PREFIX" '.branchPrefix=$v' <<<"$j")"
  [[ -n "${WT_NAME_PATTERN:-}" ]]  && j="$(jq -c --arg v "$WT_NAME_PATTERN" '.namePattern=$v' <<<"$j")"
  [[ -n "${WT_PR_REF:-}" ]]        && j="$(jq -c --arg v "$WT_PR_REF" '.prRef=$v' <<<"$j")"
  if [[ -n "${WT_FILES_TO_LINK:-}" ]]; then
    j="$(jq -c --arg v "$WT_FILES_TO_LINK" \
      '.filesToLink = ($v | split(",") | map(gsub("^\\s+|\\s+$";"")) | map(select(length>0)))' <<<"$j")"
  fi
  echo "$j"
}

config_read_file() { # $1 path; prints its JSON or {} -- never a partial read
  local f="$1"
  [[ -f "$f" ]] || { echo '{}'; return 0; }
  if ! jq -e . "$f" >/dev/null 2>&1; then
    die "config is not valid JSON: $f"
  fi
  jq -c . "$f"
}

# Removed in 0.2.0. Presence in a user-authored config means the user expects
# behaviour that no longer exists, so this dies rather than ignoring it.
config_reject_removed() { # $1 human label for the layer, $2 json
  local label="$1" json="$2" found
  found="$(jq -r '
    [ (if has("namePattern")    then "namePattern"    else empty end)
    , (if has("fetchPrune")     then "fetchPrune"     else empty end)
    , (if has("pullRebase")     then "pullRebase"     else empty end)
    , (if has("npmInstallDirs") then "npmInstallDirs" else empty end)
    , ( (.tools // {}) | to_entries[]
        | select(.value | type == "object" and has("enabled"))
        | "tools." + .key + ".enabled" )
    ] | join(", ")' <<<"$json")"
  [[ -z "$found" ]] && return 0
  die "$label: these fields are no longer supported: $found
  namePattern/fetchPrune/pullRebase -> source selection is now CLI flags:
      wt new <name> [--pr N | --branch <ref> | --from <ref>]
  npmInstallDirs -> replaced by hooks.postCreate, a script you edit:
      wt init   (scaffolds .opencode/hooks/post-create.sh)
  tools.<name>.enabled -> remove the tool entry to disable it, or point
      \"detect\" at a binary that is absent"
}

load_config() { # $1 main_root; idempotent
  local main_root="$1" g_json r_json
  $_CFG_LOADED && return 0
  require_jq
  g_json="$(config_read_file "$(global_config_path)")"
  r_json="$(config_read_file "$main_root/.opencode/wt.json")"
  # Only the user-authored layers are checked. The built-in defaults still carry
  # the old fields until they are removed in a later task.
  config_reject_removed "$(global_config_path)" "$g_json"
  config_reject_removed "$main_root/.opencode/wt.json" "$r_json"
  WT_CONFIG="$(printf '%s\n%s\n%s\n%s\n' \
    "$(config_defaults_json | jq -c .)" "$g_json" "$r_json" "$(config_env_json)" | config_merge)"
  CFG_BASE_PATH="$(cfg '.basePath')"
  _CFG_LOADED=true
}

cfg() {      # $1 jq expression; prints the scalar value
  jq -r "$1 // empty" <<<"$WT_CONFIG"
}

cfg_list() { # $1 jq expression selecting an array; prints one element per line
  jq -r "($1 // []) | .[]" <<<"$WT_CONFIG"
}

cmd_config() {
  local show_layers=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --layers) show_layers=true; shift ;;
      *) die "unknown option for config: $1 (see --help)" ;;
    esac
  done
  local main_root
  main_root="${WT_MAIN_ROOT:-$(main_root_from "$(pwd -P)")}" || die "could not locate the main repository"
  load_config "$main_root"
  if $show_layers; then
    local g r
    g="$(global_config_path)"; r="$main_root/.opencode/wt.json"
    echo "layers, lowest precedence first:"
    echo "  1. defaults        (built in)"
    echo "  2. $g$([[ -f "$g" ]] || echo '   (absent)')"
    echo "  3. $r$([[ -f "$r" ]] || echo '   (absent)')"
    echo "  4. WT_* env vars$([[ "$(config_env_json)" == '{}' ]] && echo '   (none set)')"
    echo
  fi
  jq . <<<"$WT_CONFIG"
}

cmd_init() {
  local force=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      *) die "unknown option for init: $1 (see --help)" ;;
    esac
  done
  require_jq
  local main_root cfg_path hooks
  main_root="${WT_MAIN_ROOT:-$(main_root_from "$(pwd -P)")}" || die "could not locate the main repository"
  cfg_path="$main_root/.opencode/wt.json"
  hooks="$main_root/.opencode/hooks"
  if [[ -f "$cfg_path" ]] && ! $force; then
    die "config already exists: $cfg_path (use --force to overwrite)"
  fi
  mkdir -p "$(dirname "$cfg_path")" "$hooks"
  config_defaults_json > "$cfg_path.tmp" && mv "$cfg_path.tmp" "$cfg_path"
  echo "config written:  $cfg_path"
}


cmd_install() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config-home) [[ $# -ge 2 ]] || die "option --config-home requires a path"
                     WT_CONFIG_HOME="$2"; shift 2 ;;
      --config-home=*) WT_CONFIG_HOME="${1#--config-home=}"; shift ;;
      # The old flags drove an interactive schema walkthrough that no longer
      # exists. Dying is deliberate: silently accepting them would hide a stale
      # script or a stale habit.
      --reset|--non-interactive|--defaults) die "flag no longer supported: $1 (repo config is now written by 'wt init')" ;;
      --config|--config=*) die "flag no longer supported: $1 (repo config always lives at <repo>/.opencode/wt.json)" ;;
      *) die "unknown option for install: $1 (see --help)" ;;
    esac
  done
  require_jq

  local script bin wrapper gcfg
  script="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

  gcfg="$(global_config_path)"
  if [[ ! -f "$gcfg" ]]; then
    mkdir -p "$(dirname "$gcfg")"
    cat > "$gcfg" <<'JSON'
{
  "filesToLink": ["CLAUDE.local.md", ".claude/settings.local.json", ".env"]
}
JSON
    echo "global config written: $gcfg"
  else
    echo "global config already present: $gcfg"
  fi

  if [[ -n "${WT_BIN:-}" ]]; then bin="$WT_BIN"
  elif [[ -d "/opt/homebrew/bin" ]]; then bin="/opt/homebrew/bin"
  elif [[ -w "/usr/local/bin" ]]; then bin="/usr/local/bin"
  else bin="$HOME/.local/bin"; fi
  mkdir -p "$bin"

  wrapper="$bin/wt"
  cat > "$wrapper" <<EOF
#!/usr/bin/env bash
# Deliberately does not pin a repository: wt resolves the repo from the
# current directory, like git. Set WT_MAIN_ROOT yourself to override.
exec "$script" "\$@"
EOF
  chmod +x "$wrapper"

  case ":$PATH:" in
    *":$bin:"*) ;;
    *)
      echo "⚠️  $bin is not on your PATH. add this to ~/.zshrc:"
      echo "  export PATH=\"$bin:\$PATH\""
      ;;
  esac
  echo "installed: $wrapper -> $script"
  echo "next: cd into a repository and run 'wt init' if it needs its own settings"
}

clean_artifacts() {
  local wt="$1" f
  local d
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    # dataDir is user-authored config: only ever delete inside the worktree, or
    # a stray "../.." would turn clean into a delete-anything primitive
    case "$d" in
      "$wt"/*) rm -rf "$d" ;;
      *) echo "wt: warning: refusing to remove a dataDir outside the worktree: $d" >&2 ;;
    esac
  done < <(tools_data_dirs "$wt")
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    if [[ -L "$wt/$f" ]]; then
      rm -f "$wt/$f"
    fi
  done < <(cfg_list '.filesToLink')
}

resolve_worktree_target() {
  local target="${1:-}"
  local main_root wt base registered m
  main_root="$(main_root_from "$(pwd -P)")" || die "could not locate the main repository"
  load_config "$main_root"
  main_root="$(cd "$main_root" && pwd -P)"

  if [[ -z "$target" ]]; then
    wt="$(pwd -P)"
  elif [[ -d "$target" ]]; then
    wt="$(cd "$target" && pwd -P)"
  else
    wt="$main_root/$CFG_BASE_PATH/$target"
    if [[ ! -d "$wt" ]]; then
      die "worktree not found: $CFG_BASE_PATH/$target (see 'wt list')"
    fi
  fi
  wt="$(cd "$wt" && pwd -P)"

  # Attribute the path to the worktree that contains it, so bare commands work
  # from any subdirectory. Longest match wins, otherwise everything inside the
  # repository would be attributed to the main worktree. The main repository
  # itself only matches exactly -- a stray directory under basePath must report
  # "not a registered worktree", not "refusing to act on the main repository".
  local best="" m_phys
  registered="$(git -C "$main_root" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree /{sub(/^worktree /,""); print}')"
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    m_phys="$(cd "$m" 2>/dev/null && pwd -P)" || continue
    if [[ "$m_phys" == "$main_root" ]]; then
      [[ "$wt" == "$m_phys" ]] || continue
    elif [[ "$wt" != "$m_phys" && "$wt" != "$m_phys"/* ]]; then
      continue
    fi
    [[ ${#m_phys} -gt ${#best} ]] && best="$m_phys"
  done <<< "$registered"
  [[ -n "$best" ]] || die "not a registered worktree of $main_root: $wt (see 'wt list')"
  wt="$best"

  [[ "$wt" != "$main_root" ]] || die "refusing to act on the main repository: $wt"

  base="${CFG_BASE_PATH#./}"
  base="${base%/}"
  [[ "$wt" == "$main_root/$base/"* ]] \
    || die "not a worktree of this repository (expected under $main_root/$base): $wt (see 'wt list')"

  echo "$wt"
}

cmd_clean() {
  local wt mr
  mr="$(main_root_from "$(pwd -P)")" || die "could not locate the main repository"
  load_config "$mr"
  wt="$(resolve_worktree_target "${1:-}" | tail -1)"
  clean_artifacts "$wt"
  echo "  artifacts cleaned: $wt"
}

cmd_teardown() {
  local force=false target="" arg
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --force) force=true; shift ;;
      -*) die "unknown option for teardown: $arg (see --help)" ;;
      *)
        [[ -z "$target" ]] || die "teardown takes at most one worktree, got '$target' and '$arg'"
        target="$arg"; shift ;;
    esac
  done

  local wt mr0
  mr0="$(main_root_from "$(pwd -P)")" || die "could not locate the main repository"
  load_config "$mr0"
  wt="$(resolve_worktree_target "$target" | tail -1)"

  local main_root branch b
  main_root="$(main_root_from "$wt")" || die "could not locate main repository root above $wt"
  branch="$(git -C "$wt" worktree list --porcelain 2>/dev/null | awk -v w="$wt" '
    /^worktree / { inblock = ($0 == "worktree " w) }
    inblock && /^branch / { sub(/^branch /, ""); print; exit }
  ' || true)"
  b="${branch#refs/heads/}"

  if ! $force; then
    local dirty unmerged="" own
    dirty="$(git -C "$wt" status --porcelain 2>/dev/null || true)"
    own="$(wt_own_paths "$wt")"
    if [[ -n "$dirty" && -n "$own" ]]; then
      local filtered="" line path o keep
      while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        path="${line:3}"          # strip the two status chars and the space
        path="${path#\"}"; path="${path%\"}"
        path="${path%/}"          # untracked directories come with a trailing /
        keep=1
        while IFS= read -r o; do
          [[ -n "$o" ]] || continue
          if [[ "$path" == "$o" ]]; then keep=0; break; fi
        done <<< "$own"
        [[ $keep -eq 1 ]] && filtered+="$line"$'\n'
      done <<< "$dirty"
      dirty="${filtered%$'\n'}"
    fi
    # git marks the current branch with '*' and any branch checked out in a
    # linked worktree with '+'. The branch being torn down always carries '+',
    # so both prefixes must be stripped or every teardown looks unmerged.
    if [[ -n "$b" ]] && ! git -C "$main_root" branch --merged HEAD 2>/dev/null \
        | sed 's/^[*+ ]*//' | grep -Fxq "$b"; then
      unmerged="$b"
    fi
    if [[ -n "$dirty" || -n "$unmerged" ]]; then
      echo "wt: error: refusing to tear down $wt" >&2
      if [[ -n "$dirty" ]]; then
        echo "  uncommitted changes:" >&2
        printf '%s\n' "$dirty" | sed 's/^/    /' >&2
      fi
      if [[ -n "$unmerged" ]]; then
        echo "  branch '$unmerged' has unmerged commits (not reachable from HEAD of $main_root)" >&2
      fi
      echo "  commit your work first, or re-run with --force to discard it" >&2
      exit 1
    fi
  fi

  local invoked_from
  invoked_from="$(pwd -P 2>/dev/null || true)"

  run_hook preTeardown "$wt"
  tools_run teardown "$wt"
  clean_artifacts "$wt"

  git -C "$main_root" worktree remove --force "$wt"
  echo "  worktree removed: $wt"

  if [[ -n "$b" ]]; then
    if git -C "$main_root" branch -D "$b" >/dev/null 2>&1; then
      echo "  branch deleted: $b"
    else
      echo "  branch not deleted (checked out elsewhere?): $b"
    fi
  fi
  echo "teardown complete"

  if [[ -n "$invoked_from" && ( "$invoked_from" == "$wt" || "$invoked_from" == "$wt"/* ) ]]; then
    if [[ ! -t 0 && "${WT_OPEN:-auto}" != "none" ]]; then
      echo "reopening opencode at the repository root..."
      open_in_terminal "$main_root"
    else
      echo "note: you were inside the removed worktree. go back to the repo root:"
      echo "  cd \"$main_root\""
    fi
  fi
}

cmd_test() {
  local self
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  local passes=0
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT

  fail() { echo "  FAIL  $*" >&2; exit 1; }
  pass() { passes=$((passes + 1)); echo "  ok  $1"; }

  mkdir -p "$tmp/bin" "$tmp/repo" "$tmp/remote.git"
  cat > "$tmp/bin/codegraph" <<STUB
#!/usr/bin/env bash
[[ -n "\$CODEGRAPH_DATA_DIR" && -n "\$CODEGRAPH_PROJECT_PATH" ]] || exit 1
mkdir -p "\$CODEGRAPH_DATA_DIR"
touch "$tmp/codegraph_called"
STUB
  chmod +x "$tmp/bin/codegraph"

  cat > "$tmp/bin/npm" <<'STUB'
#!/usr/bin/env bash
[[ -f package.json ]] || exit 1
mkdir -p node_modules
STUB
  chmod +x "$tmp/bin/npm"

  git -C "$tmp/remote.git" init --bare -q

  git -C "$tmp/repo" init -q
  echo hi > "$tmp/repo/file.txt"
  echo secrets > "$tmp/repo/.env"
  echo local > "$tmp/repo/CLAUDE.local.md"
  mkdir -p "$tmp/repo/apps/frontend"
  echo '{}' > "$tmp/repo/package.json"
  echo '{}' > "$tmp/repo/apps/frontend/package.json"
  # NOTE: CLAUDE.local.md is deliberately absent here. It is a filesToLink
  # default, so leaving it untracked is what proves the teardown filter works.
  cat > "$tmp/repo/.gitignore" <<'IGNORE'
.env
.claude/
node_modules/
.codegraph-*
.git-worktrees/
IGNORE
  git -C "$tmp/repo" add file.txt package.json apps/frontend/package.json .gitignore
  git -C "$tmp/repo" -c user.email=t@t -c user.name=t commit -qm init

  local default_branch
  default_branch="$(git -C "$tmp/repo" branch --show-current)"

  git -C "$tmp/repo" remote add origin "$tmp/remote.git"
  git -C "$tmp/repo" push -q -u origin "$default_branch"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/1234/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/2345/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/3456/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/4567/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/5678/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/6789/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/7890/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/8901/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/9012/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/1357/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/2468/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/3579/head"
  git -C "$tmp/repo" push -q origin "$default_branch:refs/pull/4680/head"

  export PATH="$tmp/bin:$PATH"
  export WT_OPEN=none
  # never touch the real ~/.config: the suite writes a global config there
  export WT_CONFIG_HOME="$tmp/config"
  mkdir -p "$WT_CONFIG_HOME/wt"
  export WT_BIN="$tmp/bin"
  local repo
  repo="$(cd "$tmp/repo" && pwd -P)"

  # a second repository, used to prove commands act on the repo you are standing in
  mkdir -p "$tmp/repo2" "$tmp/remote2.git"
  git -C "$tmp/remote2.git" init --bare -q
  git -C "$tmp/repo2" init -q
  echo two > "$tmp/repo2/file.txt"
  git -C "$tmp/repo2" add file.txt
  git -C "$tmp/repo2" -c user.email=t@t -c user.name=t commit -qm init
  local default_branch2
  default_branch2="$(git -C "$tmp/repo2" branch --show-current)"
  git -C "$tmp/repo2" remote add origin "$tmp/remote2.git"
  git -C "$tmp/repo2" push -q -u origin "$default_branch2"
  git -C "$tmp/repo2" push -q origin "$default_branch2:refs/pull/1234/head"
  local repo2
  repo2="$(cd "$tmp/repo2" && pwd -P)"
  w() { (cd "$tmp/repo" && bash "$self" "$@"); }

  local out
  out=$(w new review-pr-1234 --pr 1234 2>&1) || fail "new review-pr-1234 --pr 1234: $out"
  [[ -d "$repo/$CFG_BASE_PATH/review-pr-1234" ]] || fail "worktree dir missing"
  [[ "$(git -C "$repo/$CFG_BASE_PATH/review-pr-1234" branch --show-current)" == "wt/review-pr-1234" ]] || fail "expected branch wt/review-pr-1234"
  [[ -L "$repo/$CFG_BASE_PATH/review-pr-1234/.env" ]] || fail ".env not symlinked"
  [[ "$(readlink "$repo/$CFG_BASE_PATH/review-pr-1234/.env")" == "$repo/.env" ]] || fail ".env symlink target wrong"
  [[ -d "$repo/$CFG_BASE_PATH/review-pr-1234/.codegraph-review-pr-1234" ]] || fail "codegraph data dir missing (env contract broken)"
  pass "new: --pr worktree, branch wt/review-pr-1234, symlinks, codegraph env contract"

  out=$(w list 2>&1) || fail "list: $out"
  grep -q "review-pr-1234" <<<"$out" || fail "list output missing review-pr-1234"
  pass "list"

  out=$(w clean review-pr-1234 2>&1) || fail "clean review-pr-1234: $out"
  [[ ! -e "$repo/$CFG_BASE_PATH/review-pr-1234/.env" ]] || fail "clean did not remove symlink"
  [[ -d "$repo/$CFG_BASE_PATH/review-pr-1234" ]] || fail "clean removed the worktree"
  pass "clean: artifacts removed, worktree kept"

  out=$(w bootstrap review-pr-1234 2>&1) || fail "bootstrap review-pr-1234: $out"
  [[ -L "$repo/$CFG_BASE_PATH/review-pr-1234/.env" ]] || fail "bootstrap did not restore symlink"
  pass "bootstrap: idempotent"

  out=$(w new nested/name 2>&1) && fail "new should reject a name containing a slash"
  grep -qi "plain folder name" <<<"$out" || fail "error should explain the name must be a plain folder name, got: $out"
  out=$(w new a b 2>&1) && fail "new should reject two names"
  grep -qi "at most one name" <<<"$out" || fail "error should say at most one name, got: $out"
  pass "new: rejects a path-like name and a second name"

  out=$(w new review-pr-99999 --pr 99999 2>&1) && fail "new review-pr-99999 should have failed (PR does not exist)"
  grep -q "99999" <<<"$out" || fail "error message should mention the PR number, got: $out"
  grep -qi "merge-requests" <<<"$out" || fail "error should hint at prRef for other forges, got: $out"
  pass "new: rejects a non-existent PR and hints at prRef"

  out=$(cd "$tmp" && WT_MAIN_ROOT="$tmp/repo" bash "$self" teardown review-pr-1234 2>&1) || fail "teardown by name from outside: $out"
  [[ ! -d "$repo/$CFG_BASE_PATH/review-pr-1234" ]] || fail "worktree not removed"
  if git -C "$tmp/repo" branch --list "wt/review-pr-1234" | grep -q .; then
    fail "branch wt/review-pr-1234 not deleted"
  fi
  pass "teardown: by name with WT_MAIN_ROOT (installed-wrapper contract)"

  local cfg="$repo/.opencode/wt.json"
  rm -f "$cfg"
  out=$(w init 2>&1) || fail "wt init: $out"
  [[ -f "$cfg" ]] || fail "init did not write $cfg"
  jq -e . "$cfg" >/dev/null 2>&1 || fail "wt.json is not valid JSON"
  [[ "$(jq -r .basePath "$cfg")" == ".git-worktrees" ]] || fail "basePath default mismatch: $(jq -r .basePath "$cfg")"
  [[ "$(jq -r '.filesToLink | join(",")' "$cfg")" == "CLAUDE.local.md,.claude/settings.local.json,.env" ]] \
    || fail "filesToLink default mismatch"
  pass "init: writes a default repo config"

  echo '{"basePath":".custom"}' > "$cfg"
  out=$(w init 2>&1) && fail "init should refuse to overwrite an existing config"
  [[ "$(jq -r .basePath "$cfg")" == ".custom" ]] || fail "refused init still overwrote the config"
  out=$(w init --force 2>&1) || fail "init --force: $out"
  [[ "$(jq -r .basePath "$cfg")" == ".git-worktrees" ]] || fail "init --force did not reset the config"
  pass "init: refuses to overwrite without --force"

  # install is machine scope only: it must never write into a repository
  local scfg="$tmp/splitcfg"
  rm -rf "$scfg" "$cfg"
  out=$(cd "$tmp/repo" && WT_CONFIG_HOME="$scfg" WT_BIN="$tmp/bin" bash "$self" install 2>&1) || fail "wt install: $out"
  [[ -f "$scfg/wt/config.json" ]] || fail "install did not write the global config"
  [[ -x "$tmp/bin/wt" ]] || fail "install did not write the shim"
  [[ ! -f "$cfg" ]] || fail "install must not write into a repository"
  pass "install: machine scope only, never touches a repository"

  # invalid JSON in a config is fatal, never a silent fallback to defaults
  local badcfg="$tmp/badcfg"
  mkdir -p "$badcfg/.opencode"
  (cd "$badcfg" && git init -q)
  echo 'not json' > "$badcfg/.opencode/wt.json"
  out=$(cd "$badcfg" && WT_MAIN_ROOT="$badcfg" bash "$self" config 2>&1) \
    && fail "invalid JSON config should have been rejected"
  grep -q "not valid JSON" <<<"$out" || fail "expected 'not valid JSON', got: $out"
  pass "config: invalid JSON is fatal, not a silent fallback"

  jq -n '{basePath: ".wt-trees"}' > "$cfg"
  out=$(w new review-pr-1234 --pr 1234 2>&1) || fail "new (config basePath .wt-trees): $out"
  [[ -d "$repo/.wt-trees/review-pr-1234" ]] || fail "worktree not at configured basePath .wt-trees"
  [[ "$(git -C "$repo/.wt-trees/review-pr-1234" branch --show-current)" == "wt/review-pr-1234" ]] || fail "branch wrong with configured basePath"
  pass "config: custom basePath creates worktree there"

  jq -n '{tools: {"!codegraph": true}}' > "$cfg"
  rm -f "$tmp/codegraph_called"
  out=$(w new review-pr-2345 --pr 2345 2>&1) || fail "new (codegraph removed): $out"
  [[ -d "$repo/.git-worktrees/review-pr-2345" ]] || fail "worktree not created with codegraph removed"
  [[ ! -e "$repo/.git-worktrees/review-pr-2345/.codegraph-review-pr-2345" ]] || fail "codegraph data dir created despite removal"
  [[ ! -f "$tmp/codegraph_called" ]] || fail "codegraph binary invoked despite removal"
  pass "config: !name removes an inherited tool"

  jq -n '{basePath: ".cfg-trees"}' > "$cfg"
  out=$(cd "$tmp/repo" && WT_BASE=.env-trees bash "$self" new review-pr-4567 2>&1) || fail "new with WT_BASE override: $out"
  [[ -d "$repo/.env-trees/review-pr-4567" ]] || fail "worktree not at WT_BASE override .env-trees"
  [[ ! -d "$repo/.cfg-trees/review-pr-4567" ]] || fail "env override did not win over config basePath"
  pass "config: WT_BASE env var overrides config basePath"

  jq -n '{branchPrefix: "pr/"}' > "$cfg"
  out=$(w new review-pr-3456 --pr 3456 2>&1) || fail "new with a custom branchPrefix: $out"
  [[ -d "$repo/.git-worktrees/review-pr-3456" ]] || fail "worktree not created for review-pr-3456"
  [[ "$(git -C "$repo/.git-worktrees/review-pr-3456" branch --show-current)" == "pr/review-pr-3456" ]] \
    || fail "expected branch pr/review-pr-3456"
  pass "config: branchPrefix drives branch naming"

  # defect A — bare invocations must not crash under `set -u`
  rm -f "$cfg"   # reset to built-in defaults

  out=$(w new review-pr-5678 --pr 5678 2>&1) || fail "new review-pr-5678: $out"
  out=$(cd "$repo/.git-worktrees/review-pr-5678" && bash "$self" bootstrap 2>&1) \
    || fail "bare bootstrap from inside the worktree: $out"
  [[ -L "$repo/.git-worktrees/review-pr-5678/.env" ]] || fail "bare bootstrap did not link .env"

  out=$(cd "$repo/.git-worktrees/review-pr-5678" && bash "$self" clean 2>&1) \
    || fail "bare clean from inside the worktree: $out"
  [[ ! -e "$repo/.git-worktrees/review-pr-5678/.env" ]] || fail "bare clean did not remove the symlink"
  [[ -d "$repo/.git-worktrees/review-pr-5678" ]] || fail "bare clean removed the worktree"

  out=$(cd "$repo/.git-worktrees/review-pr-5678" && bash "$self" teardown 2>&1) \
    || fail "bare teardown from inside the worktree: $out"
  [[ ! -d "$repo/.git-worktrees/review-pr-5678" ]] || fail "bare teardown did not remove the worktree"
  pass "bare bootstrap/clean/teardown work from inside a worktree"

  # defect B — the global shim must not be pinned to one repository
  rm -f "$cfg"
  out=$(w install 2>&1) || fail "install for shim test: $out"
  [[ -x "$tmp/bin/wt" ]] || fail "install did not write an executable shim at $tmp/bin/wt"
  if grep -q "WT_MAIN_ROOT=" "$tmp/bin/wt"; then
    fail "shim pins WT_MAIN_ROOT; it must resolve the repository from the current directory"
  fi
  out=$(cd "$tmp/repo2" && "$tmp/bin/wt" new review-pr-1234 --pr 1234 2>&1) || fail "shim new inside repo2: $out"
  [[ -d "$repo2/.git-worktrees/review-pr-1234" ]] || fail "shim did not create the worktree in repo2"
  [[ ! -d "$repo/.git-worktrees/review-pr-1234" ]] || fail "shim leaked a worktree into the install-time repository"
  pass "install: shim resolves the repository from cwd, not from install time"

  # defect B2 — a worktree belonging to another repository must be refused
  rm -f "$cfg"
  [[ -d "$repo2/.git-worktrees/review-pr-1234" ]] || fail "ownership test needs repo2's worktree from the shim test"

  out=$(cd "$tmp/repo" && bash "$self" teardown "$repo2/.git-worktrees/review-pr-1234" 2>&1) \
    && fail "teardown accepted a worktree belonging to another repository"
  [[ -d "$repo2/.git-worktrees/review-pr-1234" ]] || fail "refused teardown still removed the other repository's worktree"

  out=$(cd "$tmp/repo" && bash "$self" teardown "$repo" 2>&1) \
    && fail "teardown accepted the main repository itself"
  [[ -d "$repo/.git" ]] || fail "teardown damaged the main repository"

  mkdir -p "$repo/.git-worktrees/not-a-worktree"
  out=$(cd "$tmp/repo" && bash "$self" teardown not-a-worktree 2>&1) \
    && fail "teardown accepted a plain directory that is not a registered worktree"
  rm -rf "$repo/.git-worktrees/not-a-worktree"
  pass "teardown: refuses other repositories, the main repo, and unregistered directories"

  # defect E — teardown must not silently discard work
  rm -f "$cfg"

  out=$(w new review-pr-6789 --pr 6789 2>&1) || fail "new review-pr-6789: $out"
  echo "uncommitted" >> "$repo/.git-worktrees/review-pr-6789/file.txt"
  out=$(w teardown review-pr-6789 2>&1) && fail "teardown removed a dirty worktree without --force"
  grep -q "uncommitted" <<<"$out" || fail "refusal should name the uncommitted changes, got: $out"
  [[ -d "$repo/.git-worktrees/review-pr-6789" ]] || fail "refused teardown still removed the worktree"
  out=$(w teardown review-pr-6789 --force 2>&1) || fail "teardown --force on a dirty worktree: $out"
  [[ ! -d "$repo/.git-worktrees/review-pr-6789" ]] || fail "--force did not remove the worktree"

  out=$(w new review-pr-7890 --pr 7890 2>&1) || fail "new review-pr-7890: $out"
  echo "extra" >> "$repo/.git-worktrees/review-pr-7890/file.txt"
  git -C "$repo/.git-worktrees/review-pr-7890" add file.txt
  git -C "$repo/.git-worktrees/review-pr-7890" -c user.email=t@t -c user.name=t commit -qm "unmerged work"
  out=$(w teardown review-pr-7890 2>&1) && fail "teardown deleted a branch with unmerged commits without --force"
  grep -q "unmerged" <<<"$out" || fail "refusal should mention unmerged commits, got: $out"
  [[ -d "$repo/.git-worktrees/review-pr-7890" ]] || fail "refused teardown still removed the worktree"
  out=$(w teardown review-pr-7890 --force 2>&1) || fail "teardown --force with unmerged commits: $out"
  [[ ! -d "$repo/.git-worktrees/review-pr-7890" ]] || fail "--force did not remove the worktree"
  pass "teardown: refuses dirty worktrees and unmerged branches without --force"

  # defect C — cwd must be captured before the worktree is removed
  rm -f "$cfg"

  out=$(w new review-pr-8901 --pr 8901 2>&1) || fail "new review-pr-8901: $out"
  out=$(cd "$repo/.git-worktrees/review-pr-8901" && bash "$self" teardown 2>&1) \
    || fail "teardown from inside the worktree: $out"
  grep -q "you were inside the removed worktree" <<<"$out" \
    || fail "expected the cwd recovery notice, got: $out"
  grep -q "cd \"$repo\"" <<<"$out" || fail "recovery notice should name the repo root, got: $out"
  if grep -q "getcwd" <<<"$out"; then
    fail "teardown read the working directory after deleting it: $out"
  fi

  out=$(w new review-pr-9012 --pr 9012 2>&1) || fail "new review-pr-9012: $out"
  mkdir -p "$repo/.git-worktrees/review-pr-9012/nested/deep"
  out=$(cd "$repo/.git-worktrees/review-pr-9012/nested/deep" && bash "$self" teardown 2>&1) \
    || fail "teardown from a nested directory inside the worktree: $out"
  grep -q "you were inside the removed worktree" <<<"$out" \
    || fail "recovery notice should fire from a nested directory too, got: $out"
  pass "teardown: cwd recovery notice fires from the worktree and its subdirectories"

  # config merge semantics — objects by key, arrays union, ! removes
  m() { printf '%s\n' "$@" | (cd "$tmp/repo" && bash "$self" __merge); }

  [[ "$(m '{"tools":{"cg":{"d":1}}}' '{"tools":{"dk":{"d":2}}}')" \
     == '{"tools":{"cg":{"d":1},"dk":{"d":2}}}' ]] || fail "merge: maps must merge by key"
  [[ "$(m '{"f":["a",".env"]}' '{"f":[".env.test","!.env"]}')" \
     == '{"f":["a",".env.test"]}' ]] || fail "merge: ! must remove an inherited array entry"
  [[ "$(m '{"f":["a","b","c"]}' '{"f":["b","d"]}')" \
     == '{"f":["a","b","c","d"]}' ]] || fail "merge: arrays must union in order without duplicates"
  [[ "$(m '{"p":"x"}' '{"p":null}')" == '{"p":"x"}' ]] || fail "merge: null must not clobber"
  [[ "$(m '{"p":true}' '{"p":false}')" == '{"p":false}' ]] || fail "merge: false must win over true"
  [[ "$(m '{"f":["a"]}' '{"f":["!ghost"]}')" == '{"f":["a"]}' ]] || fail "merge: removing an absent entry is a no-op"
  [[ "$(m '{"a":1}' '{"b":2}' '{"c":3}')" == '{"a":1,"b":2,"c":3}' ]] || fail "merge: must fold any number of layers"
  [[ "$(m '{"t":{"cg":{"x":1},"dk":{"y":2}}}' '{"t":{"!cg":true}}')" \
     == '{"t":{"dk":{"y":2}}}' ]] || fail "merge: ! must remove an inherited map key"
  [[ "$(m '{"t":{"cg":{"x":1}}}' '{"t":{}}')" \
     == '{"t":{"cg":{"x":1}}}' ]] || fail "merge: an empty map must not silently drop inherited keys"
  pass "config: merge semantics (maps, arrays, ! removal, null, false)"

  # four-layer resolution: defaults < global < repo < env
  local gcfg="$tmp/globalcfg"
  mkdir -p "$gcfg/wt"
  rm -f "$cfg"

  echo '{"branchPrefix":"global/"}' > "$gcfg/wt/config.json"
  out=$(cd "$tmp/repo" && WT_CONFIG_HOME="$gcfg" bash "$self" config 2>&1) || fail "wt config: $out"
  [[ "$(jq -r .branchPrefix <<<"$out")" == "global/" ]] || fail "global layer ignored: $out"
  [[ "$(jq -r .basePath <<<"$out")" == ".git-worktrees" ]] || fail "defaults lost under global layer: $out"

  echo '{"branchPrefix":"repo/"}' > "$cfg"
  out=$(cd "$tmp/repo" && WT_CONFIG_HOME="$gcfg" bash "$self" config 2>&1) || fail "wt config (repo layer): $out"
  [[ "$(jq -r .branchPrefix <<<"$out")" == "repo/" ]] || fail "repo layer must beat global: $out"

  out=$(cd "$tmp/repo" && WT_CONFIG_HOME="$gcfg" WT_BRANCH_PREFIX="env/" bash "$self" config 2>&1) \
    || fail "wt config (env layer): $out"
  [[ "$(jq -r .branchPrefix <<<"$out")" == "env/" ]] || fail "env layer must beat repo: $out"

  echo '{"filesToLink":["CLAUDE.local.md",".env"]}' > "$gcfg/wt/config.json"
  echo '{"filesToLink":[".env.test","!.env"]}' > "$cfg"
  out=$(cd "$tmp/repo" && WT_CONFIG_HOME="$gcfg" bash "$self" config 2>&1) || fail "wt config (arrays): $out"
  # defaults contribute to the union too, so .claude/settings.local.json survives;
  # .env is present in defaults AND global yet is removed by the repo's "!.env"
  [[ "$(jq -c .filesToLink <<<"$out")" == '["CLAUDE.local.md",".claude/settings.local.json",".env.test"]' ]] \
    || fail "filesToLink must union across layers and honour !: $out"

  out=$(cd "$tmp/repo" && WT_CONFIG_HOME="$gcfg" bash "$self" config --layers 2>&1) || fail "wt config --layers: $out"
  grep -q "defaults" <<<"$out" || fail "--layers should name the defaults layer, got: $out"
  grep -q "$cfg" <<<"$out" || fail "--layers should name the repo config path, got: $out"

  rm -f "$cfg" "$gcfg/wt/config.json"
  pass "config: four layers resolve defaults < global < repo < env"

  # removed fields must be rejected, never silently ignored
  local badcfg2="$tmp/badcfg2"
  mkdir -p "$badcfg2/.opencode"
  (cd "$badcfg2" && git init -q)
  local rf
  for rf in namePattern fetchPrune pullRebase npmInstallDirs; do
    echo "{\"$rf\":null}" > "$badcfg2/.opencode/wt.json"
    out=$(cd "$badcfg2" && WT_MAIN_ROOT="$badcfg2" bash "$self" config 2>&1) \
      && fail "config accepted removed field '$rf'"
    grep -q "$rf" <<<"$out" || fail "error should name the removed field '$rf', got: $out"
    grep -qi "no longer" <<<"$out" || fail "error should say the field is no longer supported, got: $out"
  done
  echo '{"tools":{"codegraph":{"enabled":true}}}' > "$badcfg2/.opencode/wt.json"
  out=$(cd "$badcfg2" && WT_MAIN_ROOT="$badcfg2" bash "$self" config 2>&1) \
    && fail "config accepted removed field tools.*.enabled"
  grep -q "enabled" <<<"$out" || fail "error should name tools.*.enabled, got: $out"
  pass "config: removed fields are rejected with an actionable message"

  # tools: env contract, detect gating, dataDir cleanup
  cat > "$tmp/bin/faketool" <<STUB
#!/usr/bin/env bash
[[ -n "\$FAKE_ROOT" && -n "\$FAKE_DATA" ]] || exit 1
mkdir -p "\$FAKE_DATA"
echo "\$FAKE_ROOT" > "\$FAKE_DATA/root"
STUB
  chmod +x "$tmp/bin/faketool"

  jq -n '{tools: {"!codegraph": true, faketool: {
            detect: "faketool",
            dataDir: ".fake-{name}",
            env: {FAKE_ROOT: "{worktree}", FAKE_DATA: "{dataDir}"},
            setup: "faketool"
          }}}' > "$cfg"
  out=$(w new review-pr-5678 --pr 5678 2>&1) || fail "new with a custom tool: $out"
  local fwt="$repo/.git-worktrees/review-pr-5678"
  [[ -d "$fwt/.fake-review-pr-5678" ]] || fail "tool dataDir not created: $out"
  [[ "$(cat "$fwt/.fake-review-pr-5678/root")" == "$fwt" ]] \
    || fail "tool env {worktree} not expanded to the worktree path"

  out=$(w clean review-pr-5678 2>&1) || fail "clean with a custom tool: $out"
  [[ ! -e "$fwt/.fake-review-pr-5678" ]] || fail "clean did not remove the tool dataDir"
  out=$(w teardown review-pr-5678 --force 2>&1) || fail "teardown after tool test: $out"

  # detect gating: an absent binary skips the tool but still creates the worktree
  jq -n '{tools: {"!codegraph": true, ghosttool: {detect: "definitely-not-installed", setup: "definitely-not-installed"}}}' > "$cfg"
  out=$(w new review-pr-6789 --pr 6789 2>&1) || fail "new must succeed when a tool binary is absent: $out"
  [[ -d "$repo/.git-worktrees/review-pr-6789" ]] || fail "worktree not created with an absent tool"
  grep -qi "skip" <<<"$out" || fail "absent tool should be reported as skipped, got: $out"
  out=$(w teardown review-pr-6789 --force 2>&1) || fail "teardown after detect test: $out"

  # a dataDir escaping the worktree must never be deleted
  jq -n '{tools: {"!codegraph": true, escapee: {dataDir: "../../escape-{name}"}}}' > "$cfg"
  out=$(w new review-pr-7890 --pr 7890 2>&1) || fail "new with an escaping dataDir: $out"
  mkdir -p "$repo/../escape-review-pr-7890" 2>/dev/null || true
  out=$(w clean review-pr-7890 2>&1) || fail "clean with an escaping dataDir: $out"
  [[ -d "$repo/../escape-review-pr-7890" ]] || fail "clean deleted a dataDir outside the worktree"
  rm -rf "$repo/../escape-review-pr-7890"
  out=$(w teardown review-pr-7890 --force 2>&1) || fail "teardown after escape test: $out"

  rm -f "$cfg"
  pass "tools: env contract, detect gating, dataDir cleanup, escape guard"

  # hooks: file form, inline form, env contract, missing-file tolerance
  mkdir -p "$repo/.opencode/hooks"
  cat > "$repo/.opencode/hooks/post-create.sh" <<'HOOK'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$WT_NAME" "$WT_ROOT" "$WT_MAIN_ROOT" "$WT_BRANCH" "$PWD" > .hook-ran
HOOK
  chmod +x "$repo/.opencode/hooks/post-create.sh"
  jq -n '{tools:{"!codegraph":true}, hooks:{postCreate:".opencode/hooks/post-create.sh"}}' > "$cfg"

  out=$(w new review-pr-8901 --pr 8901 2>&1) || fail "new with a file hook: $out"
  local hwt="$repo/.git-worktrees/review-pr-8901"
  [[ -f "$hwt/.hook-ran" ]] || fail "postCreate hook did not run: $out"
  [[ "$(sed -n 1p "$hwt/.hook-ran")" == "review-pr-8901" ]] || fail "hook WT_NAME wrong"
  [[ "$(sed -n 2p "$hwt/.hook-ran")" == "$hwt" ]] || fail "hook WT_ROOT wrong"
  [[ "$(sed -n 3p "$hwt/.hook-ran")" == "$repo" ]] || fail "hook WT_MAIN_ROOT wrong"
  [[ "$(sed -n 4p "$hwt/.hook-ran")" == "wt/review-pr-8901" ]] || fail "hook WT_BRANCH wrong"
  [[ "$(sed -n 5p "$hwt/.hook-ran")" == "$hwt" ]] || fail "hook cwd must be the worktree"
  out=$(w teardown review-pr-8901 --force 2>&1) || fail "teardown after file-hook test: $out"

  jq -n '{tools:{"!codegraph":true}, hooks:{postCreate:"echo inline > .hook-inline"}}' > "$cfg"
  out=$(w new review-pr-9012 --pr 9012 2>&1) || fail "new with an inline hook: $out"
  [[ "$(cat "$repo/.git-worktrees/review-pr-9012/.hook-inline")" == "inline" ]] || fail "inline hook did not run"
  out=$(w teardown review-pr-9012 --force 2>&1) || fail "teardown after inline-hook test: $out"

  jq -n '{tools:{"!codegraph":true}, hooks:{postCreate:".opencode/hooks/nope.sh"}}' > "$cfg"
  out=$(w new review-pr-1357 --pr 1357 2>&1) || fail "a missing hook file must not fail worktree creation: $out"
  [[ -d "$repo/.git-worktrees/review-pr-1357" ]] || fail "worktree not created with a missing hook"
  grep -qi "warning" <<<"$out" || fail "a missing hook should warn, got: $out"
  out=$(w teardown review-pr-1357 --force 2>&1) || fail "teardown after missing-hook test: $out"

  # preTeardown runs before the worktree is removed
  jq -n '{tools:{"!codegraph":true}, hooks:{preTeardown:"touch \"$WT_MAIN_ROOT/.pre-teardown-ran\""}}' > "$cfg"
  rm -f "$repo/.pre-teardown-ran"
  out=$(w new review-pr-2468 --pr 2468 2>&1) || fail "new for preTeardown test: $out"
  out=$(w teardown review-pr-2468 --force 2>&1) || fail "teardown with preTeardown hook: $out"
  [[ -f "$repo/.pre-teardown-ran" ]] || fail "preTeardown hook did not run"
  rm -f "$repo/.pre-teardown-ran"

  rm -rf "$repo/.opencode/hooks"; rm -f "$cfg"
  pass "hooks: file form, inline form, env contract, missing file tolerated"

  # source selection via flags
  jq -n '{tools:{"!codegraph":true}, branchPrefix:"wt/"}' > "$cfg"

  out=$(w new spike-auth 2>&1) || fail "new with no source flag: $out"
  [[ -d "$repo/.git-worktrees/spike-auth" ]] || fail "plain-name worktree not created"
  [[ "$(git -C "$repo/.git-worktrees/spike-auth" branch --show-current)" == "wt/spike-auth" ]] \
    || fail "expected branch wt/spike-auth, got $(git -C "$repo/.git-worktrees/spike-auth" branch --show-current)"
  out=$(w teardown spike-auth --force 2>&1) || fail "teardown spike-auth: $out"

  out=$(w new audit --pr 3579 2>&1) || fail "new --pr 3579: $out"
  [[ -d "$repo/.git-worktrees/audit" ]] || fail "--pr worktree not created"
  out=$(w teardown audit --force 2>&1) || fail "teardown audit: $out"

  out=$(w new --pr 4680 2>&1) || fail "new --pr with no name: $out"
  [[ -d "$repo/.git-worktrees/pr-4680" ]] || fail "--pr with no name should auto-name pr-4680"
  out=$(w teardown pr-4680 --force 2>&1) || fail "teardown pr-4680: $out"

  # -a -m and an explicit identity: the fixture must not depend on the user's
  # global git config (tag.gpgSign / forceSignAnnotated make a bare tag fail)
  git -C "$tmp/repo" -c tag.gpgSign=false -c user.email=t@t -c user.name=t \
    tag -f -a -m t v9.9.9 "$default_branch" >/dev/null 2>&1 || fail "could not create tag v9.9.9"
  out=$(w new hotfix --from v9.9.9 2>&1) || fail "new --from a tag: $out"
  [[ -d "$repo/.git-worktrees/hotfix" ]] || fail "--from worktree not created"
  out=$(w teardown hotfix --force 2>&1) || fail "teardown hotfix: $out"

  git -C "$tmp/repo" push -q origin "$default_branch:refs/heads/feat-theirs" || fail "could not push feat-theirs"
  out=$(w new theirs --branch feat-theirs 2>&1) || fail "new --branch: $out"
  [[ -d "$repo/.git-worktrees/theirs" ]] || fail "--branch worktree not created"
  out=$(w teardown theirs --force 2>&1) || fail "teardown theirs: $out"

  out=$(w new x --pr 1 --branch y 2>&1) && fail "two source flags should be rejected"
  grep -qi "one source" <<<"$out" || fail "error should say only one source is allowed, got: $out"

  out=$(w new nopen --no-open 2>&1) || fail "new --no-open: $out"
  grep -q "cd \"" <<<"$out" || fail "--no-open should print the cd line, got: $out"
  out=$(w teardown nopen --force 2>&1) || fail "teardown nopen: $out"

  rm -f "$cfg"
  pass "new: --pr / --branch / --from / default branch / --no-open"

  # a symlink wt created must not count as the user's uncommitted work.
  # CLAUDE.local.md is deliberately NOT in the fixture .gitignore, so without
  # the filter it shows as "?? CLAUDE.local.md" and teardown refuses forever.
  jq -n '{tools:{"!codegraph":true}, filesToLink:["CLAUDE.local.md",".env"]}' > "$cfg"
  out=$(w new review-pr-1357 --pr 1357 2>&1) || fail "new for own-artifact test: $out"
  local owt="$repo/.git-worktrees/review-pr-1357"
  [[ -L "$owt/CLAUDE.local.md" ]] || fail "fixture: CLAUDE.local.md was not linked"
  git -C "$owt" status --porcelain | grep -q "CLAUDE.local.md" \
    || fail "fixture broken: the linked file should be untracked, or this test proves nothing"
  out=$(w teardown review-pr-1357 2>&1) \
    || fail "teardown must not be blocked by a symlink wt itself created: $out"
  [[ ! -d "$owt" ]] || fail "teardown did not remove the worktree"

  # ...but genuine work must still block it
  out=$(w new review-pr-2468 --pr 2468 2>&1) || fail "new for real-work test: $out"
  echo "real change" >> "$repo/.git-worktrees/review-pr-2468/file.txt"
  out=$(w teardown review-pr-2468 2>&1) && fail "teardown ignored a real uncommitted change"
  grep -q "file.txt" <<<"$out" || fail "refusal should name the changed file, got: $out"
  out=$(w teardown review-pr-2468 --force 2>&1) || fail "teardown --force after real-work test: $out"

  rm -f "$cfg"
  pass "teardown: wt's own symlinks are not uncommitted work, real changes still are"

  # every ```json block in the shipped docs must be valid JSON. People copy-paste
  # these; a block that does not parse is worse than one that is merely ugly.
  local docroot docfile jsonblocks
  docroot="$(cd "$(dirname "$self")/../.." && pwd -P)"
  if [[ -f "$docroot/README.md" ]]; then
    for docfile in "$docroot/README.md" "$docroot/docs/extending.md"; do
      [[ -f "$docfile" ]] || continue
      jsonblocks=0
      while IFS= read -r block; do
        [[ -n "$block" ]] || continue
        jsonblocks=$((jsonblocks + 1))
        printf '%s' "$block" | base64 -d | jq -e . >/dev/null 2>&1 \
          || fail "invalid JSON in a \`\`\`json block of ${docfile#$docroot/} (block $jsonblocks)"
      done < <(awk '/^```json$/{f=1;buf="";next} /^```$/{if(f){print buf|"base64";close("base64");f=0}} f{buf=buf $0 "\n"}' "$docfile")
      [[ $jsonblocks -gt 0 ]] || fail "no json blocks found in ${docfile#$docroot/} — did the extractor break?"
    done
    pass "docs: every json block parses"
  else
    echo "  skip  docs json check (running outside a checkout)"
  fi

  echo "wt test: $passes groups passed"
}

case "${1:-}" in
  new) shift; cmd_new "$@" ;;
  list) shift; cmd_list "$@" ;;
  config) shift; cmd_config "$@" ;;
  init) shift; cmd_init "$@" ;;
  open) shift; cmd_open "$@" ;;
  install) shift; cmd_install "$@" ;;
  bootstrap) shift; cmd_bootstrap "$@" ;;
  clean) shift; cmd_clean "$@" ;;
  teardown) shift; cmd_teardown "$@" ;;
  test) shift; cmd_test "$@" ;;
  __merge) shift; config_merge ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $1 (see --help)" ;;
esac
